<UserControl x:Class="Iyahon_D3D11Renderer_Core.Model3D.BezierCurvePointEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Name="this">
  <Grid Margin="0,2">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="112"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <UniformGrid Grid.Row="0" Columns="5" Margin="0,0,0,4">
      <Button x:Name="btnAdd" Content="+ 追加" Margin="0,0,2,0" Padding="4,3" Click="AddButton_Click" ToolTip="制御点を追加します"/>
      <Button x:Name="btnDuplicate" Content="複製" Margin="1,0" Padding="4,3" Click="DuplicateButton_Click" ToolTip="選択中の制御点を複製します"/>
      <Button x:Name="btnRemove" Content="- 削除" Margin="1,0" Padding="4,3" Click="RemoveButton_Click" ToolTip="選択中の制御点を削除します (最低2点)"/>
      <Button x:Name="btnAutoSmooth" Content="接線自動" Margin="1,0" Padding="4,3" Click="AutoSmoothAll_Click" ToolTip="全制御点の接線ハンドルを滑らかに再計算します"/>
      <Button x:Name="btnReverse" Content="反転" Margin="2,0,0,0" Padding="4,3" Click="ReverseButton_Click" ToolTip="制御点の順番を逆転させます"/>
    </UniformGrid>

    <ListBox Grid.Row="1" x:Name="pointsList" SelectionChanged="PointsList_SelectionChanged"
             FontSize="11" Margin="0,0,0,4" HorizontalContentAlignment="Stretch"/>

    <Border Grid.Row="2" Padding="6" CornerRadius="4" BorderBrush="#444C5C" BorderThickness="1">
      <StackPanel>
        <TextBlock x:Name="selectedHeader" Text="選択中の制御点" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4"/>

        <Grid Margin="0,0,0,4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="46"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="位置" VerticalAlignment="Center" FontSize="10.5"/>
          <TextBox Grid.Column="1" x:Name="tbPosX" LostFocus="NumericField_Commit" KeyDown="NumericField_KeyDown" FontSize="11" ToolTip="X座標 (px)"/>
          <TextBlock Grid.Column="2" Text="Y" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10"/>
          <TextBox Grid.Column="3" x:Name="tbPosY" LostFocus="NumericField_Commit" KeyDown="NumericField_KeyDown" FontSize="11" ToolTip="Y座標 (px)"/>
          <TextBlock Grid.Column="4" Text="Z" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10"/>
          <TextBox Grid.Column="5" x:Name="tbPosZ" LostFocus="NumericField_Commit" KeyDown="NumericField_KeyDown" FontSize="11" ToolTip="Z座標 (px)"/>
        </Grid>

        <Grid Margin="0,0,0,4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="46"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="42"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="太さ" VerticalAlignment="Center" FontSize="10.5"/>
          <TextBox Grid.Column="1" x:Name="tbSize" LostFocus="NumericField_Commit" KeyDown="NumericField_KeyDown" FontSize="11" ToolTip="この点での線の太さ/半径 (px)"/>
          <TextBlock Grid.Column="2" Text="傾き°" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10.5"/>
          <TextBox Grid.Column="3" x:Name="tbTilt" LostFocus="NumericField_Commit" KeyDown="NumericField_KeyDown" FontSize="11" ToolTip="この点での断面ねじり角度 (度)"/>
        </Grid>

        <Grid Margin="0,0,0,4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="46"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="手前H" VerticalAlignment="Center" FontSize="10.5"/>
          <TextBox Grid.Column="1" x:Name="tbInX" LostFocus="NumericField_Commit" KeyDown="NumericField_KeyDown" FontSize="11" ToolTip="手前ハンドルオフセット X"/>
          <TextBlock Grid.Column="2" Text="Y" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10"/>
          <TextBox Grid.Column="3" x:Name="tbInY" LostFocus="NumericField_Commit" KeyDown="NumericField_KeyDown" FontSize="11" ToolTip="手前ハンドルオフセット Y"/>
          <TextBlock Grid.Column="4" Text="Z" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10"/>
          <TextBox Grid.Column="5" x:Name="tbInZ" LostFocus="NumericField_Commit" KeyDown="NumericField_KeyDown" FontSize="11" ToolTip="手前ハンドルオフセット Z"/>
        </Grid>

        <Grid Margin="0,0,0,4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="46"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="先H" VerticalAlignment="Center" FontSize="10.5"/>
          <TextBox Grid.Column="1" x:Name="tbOutX" LostFocus="NumericField_Commit" KeyDown="NumericField_KeyDown" FontSize="11" ToolTip="先ハンドルオフセット X"/>
          <TextBlock Grid.Column="2" Text="Y" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10"/>
          <TextBox Grid.Column="3" x:Name="tbOutY" LostFocus="NumericField_Commit" KeyDown="NumericField_KeyDown" FontSize="11" ToolTip="先ハンドルオフセット Y"/>
          <TextBlock Grid.Column="4" Text="Z" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10"/>
          <TextBox Grid.Column="5" x:Name="tbOutZ" LostFocus="NumericField_Commit" KeyDown="NumericField_KeyDown" FontSize="11" ToolTip="先ハンドルオフセット Z"/>
        </Grid>

        <CheckBox x:Name="cbAutoSmooth" Content="反対側ハンドルと直線に連動 (AutoSmooth)"
                  FontSize="10.5" Checked="AutoSmoothCheck_Changed" Unchecked="AutoSmoothCheck_Changed"/>

        <TextBlock Text="※ D3D11 3Dビューポート上 (オブジェクトモード) で制御点やハンドルを直接ドラッグ編集できます。"
                   FontSize="10" Opacity="0.7" TextWrapping="Wrap" Margin="0,4,0,0"/>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
