<UserControl x:Class="Iyahon_D3D11Renderer_Core.Viewport3D.Viewport3DControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shading="clr-namespace:Iyahon_D3D11Renderer_Core.Viewport3D.Shading"
             xmlns:modifiers="clr-namespace:Iyahon_D3D11Renderer_Core.Viewport3D.Modifiers"
             xmlns:ctrl="clr-namespace:Iyahon_D3D11Renderer_Core.Controls"
             MinWidth="340" MinHeight="260"
             Background="#1A1C21"
             Focusable="True"
             InputMethod.IsInputMethodEnabled="False"
             PreviewKeyDown="OnPreviewKeyDown"
             PreviewKeyUp="OnPreviewKeyUp"
             PreviewTextInput="OnPreviewTextInput"
             TextInput="OnTextInput">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="DarkToolTipStyle" TargetType="ToolTip">
            <Setter Property="Background" Value="#181B20"/>
            <Setter Property="Foreground" Value="#F0F4F8"/>
            <Setter Property="BorderBrush" Value="#4E586B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="HasDropShadow" Value="True"/>
        </Style>

        <Style TargetType="ToolTip" BasedOn="{StaticResource DarkToolTipStyle}"/>

        <Style x:Key="DarkContextMenu" TargetType="ContextMenu">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="HasDropShadow" Value="True"/>
            <Setter Property="Background" Value="#1D2129"/>
            <Setter Property="BorderBrush" Value="#4A5568"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#F1F5F9"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="4"
                                MinWidth="172">
                            <StackPanel IsItemsHost="True"
                                        KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkMenuSeparator" TargetType="Separator">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Margin" Value="6,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="#363E4D"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkMenuItem" TargetType="MenuItem">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Foreground" Value="#F1F5F9"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2563EB"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RailModeBtn" TargetType="RadioButton">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#D4D9E2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="220"/>
            <Setter Property="ToolTipService.BetweenShowDelay" Value="80"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#323742"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#485060"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2563EB"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#60A5FA"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RailToggleBtn" TargetType="ToggleButton">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#D4D9E2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="220"/>
            <Setter Property="ToolTipService.BetweenShowDelay" Value="80"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#323742"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#485060"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#C25E18"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#F59E0B"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HdrSegmentBtn" TargetType="RadioButton">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Background" Value="#2B2F37"/>
            <Setter Property="Foreground" Value="#B8C0CC"/>
            <Setter Property="BorderBrush" Value="#3D434F"/>
            <Setter Property="BorderThickness" Value="0.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="220"/>
            <Setter Property="ToolTipService.BetweenShowDelay" Value="80"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#393F4B"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2563EB"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#60A5FA"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HdrMeshBtn" TargetType="RadioButton" BasedOn="{StaticResource HdrSegmentBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3D3734"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#C25E18"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#F59E0B"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HdrIconBtn" TargetType="Button">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Background" Value="#2B2F37"/>
            <Setter Property="Foreground" Value="#D4D9E2"/>
            <Setter Property="BorderBrush" Value="#3D434F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="220"/>
            <Setter Property="ToolTipService.BetweenShowDelay" Value="80"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3B424E"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#5C667A"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2563EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HdrIconToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Background" Value="#252930"/>
            <Setter Property="Foreground" Value="#9CA5B4"/>
            <Setter Property="BorderBrush" Value="#3A404B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="220"/>
            <Setter Property="ToolTipService.BetweenShowDelay" Value="80"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#363C47"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#344960"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#6090C4"/>
                                <Setter Property="Foreground" Value="#F0F6FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PillBox" TargetType="Border">
            <Setter Property="Background" Value="#1D2026"/>
            <Setter Property="BorderBrush" Value="#383E4A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="1"/>
            <Setter Property="Margin" Value="0,1,6,1"/>
        </Style>

        <Style x:Key="MatSmallBtn" TargetType="Button" BasedOn="{StaticResource HdrIconBtn}">
            <Setter Property="Width" Value="Auto"/>
            <Setter Property="Height" Value="21"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="FontSize" Value="10.5"/>
        </Style>

        <Style x:Key="MatDarkCheckBox" TargetType="CheckBox">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="Box" Width="13" Height="13" CornerRadius="2.5"
                                    Background="#181B21" BorderBrush="#4A5568" BorderThickness="1"
                                    VerticalAlignment="Center" Margin="0,0,5,0">
                                <Path x:Name="Mark" Visibility="Collapsed"
                                      Stroke="#FFFFFF" StrokeThickness="1.7"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Data="M 2.5,6.5 L 5.2,9.3 L 10.3,3.5"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#2563EB"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="#60A5FA"/>
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#93C5FD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MatSwatchBtn" TargetType="Button">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Margin" Value="1.5"/>
            <Setter Property="BorderBrush" Value="#485060"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MatSlider" TargetType="Slider">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="SmallChange" Value="0.01"/>
            <Setter Property="LargeChange" Value="0.1"/>
        </Style>

        <Style x:Key="MatLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="MatValueText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9CA5B4"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>

        <Style x:Key="MatSectionHdr" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9CA5B4"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,8,0,3"/>
        </Style>

        <Style x:Key="DarkMatComboBox" TargetType="ComboBox">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="#E5E7EB"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="#252930" BorderBrush="#3D434F" BorderThickness="1" CornerRadius="3" Padding="4,2">
                                            <TextBlock Text="▾" Foreground="#9CA5B4" FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,2,0"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False" Margin="6,2,18,2"
                                              VerticalAlignment="Center" HorizontalAlignment="Left"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                            <Popup Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border MinWidth="{TemplateBinding ActualWidth}" MaxHeight="220"
                                        Background="#1F242C" BorderBrush="#485060" BorderThickness="1" CornerRadius="3" Padding="2">
                                    <ScrollViewer SnapsToDevicePixels="True" Focusable="False">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="Padding" Value="5,3"/>
                        <Setter Property="Foreground" Value="#E5E7EB"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="2" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#344960"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#2563EB"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WorkspaceTabBtn" TargetType="RadioButton">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="0,2,4,0"/>
            <Setter Property="Background" Value="#1E2128"/>
            <Setter Property="Foreground" Value="#9CA5B4"/>
            <Setter Property="BorderBrush" Value="#2D323C"/>
            <Setter Property="BorderThickness" Value="1,1,1,0"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4,4,0,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A2F3A"/>
                                <Setter Property="Foreground" Value="#F1F5F9"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#23262C"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#3B82F6"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 最上部：Blender 風 ワークスペース切り替えタブバー -->
        <Border Grid.Row="0" Background="#16181D" BorderBrush="#2E333D" BorderThickness="0,0,0,1" Padding="8,0,8,0">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <RadioButton Style="{StaticResource WorkspaceTabBtn}" GroupName="WorkspaceTabs"
                                 Content="レイアウト"
                                 IsChecked="{Binding IsLayoutWorkspace, Mode=OneWay}"
                                 Command="{Binding SetLayoutWorkspaceCommand}"
                                 ToolTip="3Dビューポート＋モデル編集ワークスペース"/>
                    <RadioButton Style="{StaticResource WorkspaceTabBtn}" GroupName="WorkspaceTabs"
                                 Content="シェーディング"
                                 IsChecked="{Binding IsShadingWorkspace, Mode=OneWay}"
                                 Command="{Binding SetShadingWorkspaceCommand}"
                                 ToolTip="マテリアルノードエディターでプロシージャル質感やノーマルマップを構築"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource MatSmallBtn}" Height="20" Content="↩ 戻す"
                            Command="{Binding UndoCommand}"
                            ToolTip="元に戻す [Ctrl+Z]"/>
                    <Button Style="{StaticResource MatSmallBtn}" Height="20" Content="↪ やり直す"
                            Command="{Binding RedoCommand}"
                            ToolTip="やり直す [Ctrl+Y / Ctrl+Shift+Z]"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 上部アイコンツールバー -->
        <Border Grid.Row="1" Background="#23262C" BorderBrush="#343842" BorderThickness="0,0,0,1" Padding="6,3"
                ButtonBase.Click="OnToolbarActionClicked">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- モデル編集時のみ表示：頂点 / 辺 / 面選択 ＋ モデリングツール -->
                <Border Style="{StaticResource PillBox}"
                        Visibility="{Binding IsModelEditMode, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource HdrMeshBtn}" GroupName="MeshSelect"
                                     IsChecked="{Binding IsVertexSelectMode, Mode=OneWay}"
                                     Command="{Binding SelectVertexModeCommand}"
                                     ToolTip="頂点選択 [1]">
                            <Viewbox Width="16" Height="16" IsHitTestVisible="False">
                                <Canvas Width="20" Height="20">
                                    <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.3" StrokeLineJoin="Round"
                                          Data="M 3,7 H 13 V 17 H 3 Z M 3,7 L 8,3 H 18 L 13,7 M 18,3 V 13 L 13,17"/>
                                    <Ellipse Canvas.Left="10.2" Canvas.Top="4.2" Width="5.6" Height="5.6"
                                             Fill="#FF9E3D" Stroke="#1D2026" StrokeThickness="1.0"/>
                                </Canvas>
                            </Viewbox>
                        </RadioButton>
                        <RadioButton Style="{StaticResource HdrMeshBtn}" GroupName="MeshSelect"
                                     IsChecked="{Binding IsEdgeSelectMode, Mode=OneWay}"
                                     Command="{Binding SelectEdgeModeCommand}"
                                     ToolTip="辺選択 [2]">
                            <Viewbox Width="16" Height="16" IsHitTestVisible="False">
                                <Canvas Width="20" Height="20">
                                    <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.2" StrokeLineJoin="Round"
                                          Data="M 3,7 H 13 V 17 H 3 Z M 3,7 L 8,3 H 18 L 13,7 M 18,3 V 13 L 13,17"/>
                                    <Line X1="13" Y1="7" X2="13" Y2="17" Stroke="#FF9E3D" StrokeThickness="2.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Canvas>
                            </Viewbox>
                        </RadioButton>
                        <RadioButton Style="{StaticResource HdrMeshBtn}" GroupName="MeshSelect"
                                     IsChecked="{Binding IsFaceSelectMode, Mode=OneWay}"
                                     Command="{Binding SelectFaceModeCommand}"
                                     ToolTip="面選択 [3]">
                            <Viewbox Width="16" Height="16" IsHitTestVisible="False">
                                <Canvas Width="20" Height="20">
                                    <Rectangle Canvas.Left="3" Canvas.Top="7" Width="10" Height="10" Fill="#55FF9E3D"/>
                                    <Path Stroke="#FF9E3D" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Data="M 3.5,11.5 L 8,7 M 3.5,16.5 L 12.5,7.5 M 8,16.5 L 12.5,12"/>
                                    <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.3" StrokeLineJoin="Round"
                                          Data="M 3,7 H 13 V 17 H 3 Z M 3,7 L 8,3 H 18 L 13,7 M 18,3 V 13 L 13,17"/>
                                </Canvas>
                            </Viewbox>
                        </RadioButton>

                        <Border Width="1" Background="#343842" Margin="3,3"/>

                        <RadioButton Style="{StaticResource HdrMeshBtn}" GroupName="EditGizmoMode" Width="28"
                                     IsChecked="{Binding IsEditGizmoTranslate, Mode=OneWay}"
                                     Command="{Binding EditGizmoTranslateCommand}"
                                     ToolTip="編集ギズモ: 移動 (ショートカット: G)">
                            <TextBlock Text="G" FontSize="11" FontWeight="SemiBold"/>
                        </RadioButton>
                        <RadioButton Style="{StaticResource HdrMeshBtn}" GroupName="EditGizmoMode" Width="28"
                                     IsChecked="{Binding IsEditGizmoRotate, Mode=OneWay}"
                                     Command="{Binding EditGizmoRotateCommand}"
                                     ToolTip="編集ギズモ: 回転 (ショートカット: R)">
                            <TextBlock Text="R" FontSize="11" FontWeight="SemiBold"/>
                        </RadioButton>
                        <RadioButton Style="{StaticResource HdrMeshBtn}" GroupName="EditGizmoMode" Width="28"
                                     IsChecked="{Binding IsEditGizmoScale, Mode=OneWay}"
                                     Command="{Binding EditGizmoScaleCommand}"
                                     ToolTip="編集ギズモ: 拡大縮小 (ショートカット: S)">
                            <TextBlock Text="S" FontSize="11" FontWeight="SemiBold"/>
                        </RadioButton>

                        <ToggleButton Style="{StaticResource HdrIconToggle}" Width="34" Margin="3,0,1,0"
                                      IsChecked="{Binding IsXRayEnabled}"
                                      ToolTip="透過X-Ray表示 [Alt+Z] — 裏側の頂点や辺も透かして表示">
                            <TextBlock Text="透過" FontSize="10.5"/>
                        </ToggleButton>

                        <Button Style="{StaticResource HdrIconBtn}" Width="Auto" Padding="6,0"
                                Command="{Binding ExtrudeMeshCommand}"
                                ToolTip="押し出し / 頂点追加 [E] — 選択中のアクティブマテリアルで新規面を作成">
                            <TextBlock Text="押出" FontSize="10.5"/>
                        </Button>
                        <Button Style="{StaticResource HdrIconBtn}" Width="Auto" Padding="6,0"
                                Command="{Binding MakeFaceCommand}"
                                ToolTip="選択頂点から辺/面を作成 [F] — アクティブマテリアルを使用">
                            <TextBlock Text="面張" FontSize="10.5"/>
                        </Button>
                        <Button x:Name="BtnEditAddMesh" Style="{StaticResource HdrIconBtn}" Width="Auto" Padding="6,0"
                                Click="OnAddMeshButtonClick"
                                ToolTip="メッシュ/頂点追加メニュー [Shift+A]">
                            <TextBlock Text="追加▾" FontSize="10.5"/>
                        </Button>
                        <Button x:Name="BtnEditDeleteMesh" Style="{StaticResource HdrIconBtn}" Width="Auto" Padding="6,0"
                                Click="OnDeleteMeshButtonClick"
                                ToolTip="削除メニュー [X / Delete]">
                            <TextBlock Text="削除▾" FontSize="10.5"/>
                        </Button>
                        <Button Style="{StaticResource HdrIconBtn}" Width="Auto" Padding="5,0"
                                Command="{Binding ShadeSmoothCommand}"
                                ToolTip="選択面 (未選択時は全体) をスムーズシェードに設定">
                            <TextBlock Text="滑らか" FontSize="10.5"/>
                        </Button>
                        <Button Style="{StaticResource HdrIconBtn}" Width="Auto" Padding="5,0"
                                Command="{Binding ShadeFlatCommand}"
                                ToolTip="選択面 (未選択時は全体) をフラットシェードに設定">
                            <TextBlock Text="平坦" FontSize="10.5"/>
                        </Button>
                        <Button Style="{StaticResource HdrIconBtn}" Width="Auto" Padding="5,0"
                                Command="{Binding FlipNormalsCommand}"
                                ToolTip="選択面の法線 (表裏) を反転">
                            <TextBlock Text="法線反転" FontSize="10.5"/>
                        </Button>
                        <Button Style="{StaticResource HdrIconBtn}" Width="Auto" Padding="6,0"
                                Command="{Binding ExportObjCommand}"
                                ToolTip="編集中のメッシュを Wavefront OBJ 形式で書き出し">
                            <TextBlock Text="OBJ保存" FontSize="10.5"/>
                        </Button>

                        <Border Width="1" Background="#343842" Margin="3,3"/>

                        <ComboBox Style="{StaticResource DarkMatComboBox}" Width="126" Height="24" Margin="2,0"
                                  ItemsSource="{Binding MaterialSlots}"
                                  SelectedIndex="{Binding ActiveMaterialIndex, Mode=TwoWay}"
                                  ToolTip="押し出し[E] / 面作成[F] / 追加時に使用するアクティブマテリアル">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="9" Height="9" CornerRadius="2" Margin="0,0,5,0"
                                                Background="{Binding ColorSwatch}" BorderBrush="#64748B" BorderThickness="0.8"/>
                                        <TextBlock Text="{Binding DisplayText}" TextTrimming="CharacterEllipsis" MaxWidth="92"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Style="{StaticResource HdrIconBtn}" Width="Auto" Padding="6,0"
                                Command="{Binding AssignMaterialCommand}"
                                ToolTip="選択中の面にアクティブマテリアルを割り当て">
                            <TextBlock Text="割当" FontSize="10.5"/>
                        </Button>
                        <ToggleButton Style="{StaticResource HdrIconToggle}" Width="Auto" Padding="6,0"
                                      IsChecked="{Binding IsMaterialPanelOpen}"
                                      ToolTip="マテリアルスロット管理・PBR質感編集パネルを表示">
                            <TextBlock Text="マテリアル" FontSize="10.5"/>
                        </ToggleButton>
                    </StackPanel>
                </Border>

                <!-- ワールド / ローカル座標切替 -->
                <Border Style="{StaticResource PillBox}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource HdrSegmentBtn}" GroupName="TransformSpace"
                                     IsChecked="{Binding IsWorldSpace, Mode=OneWay}"
                                     Command="{Binding SetWorldSpaceCommand}"
                                     ToolTip="ワールド座標 [Q] — シーン全体のX/Y/Z軸に沿って操作">
                            <Viewbox Width="16" Height="16" IsHitTestVisible="False">
                                <Canvas Width="20" Height="20">
                                    <Ellipse Canvas.Left="2.5" Canvas.Top="2.5" Width="15" Height="15"
                                             Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.35"/>
                                    <Ellipse Canvas.Left="6.2" Canvas.Top="2.5" Width="7.6" Height="15"
                                             Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.15"/>
                                    <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.15"
                                          Data="M 2.8,10 H 17.2 M 4.2,6.2 H 15.8 M 4.2,13.8 H 15.8"/>
                                </Canvas>
                            </Viewbox>
                        </RadioButton>
                        <RadioButton Style="{StaticResource HdrSegmentBtn}" GroupName="TransformSpace"
                                     IsChecked="{Binding IsLocalSpace, Mode=OneWay}"
                                     Command="{Binding SetLocalSpaceCommand}"
                                     ToolTip="ローカル座標 [Q] — アイテム自身の回転向きに合わせて操作">
                            <Viewbox Width="16" Height="16" IsHitTestVisible="False">
                                <Canvas Width="20" Height="20">
                                    <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.35" StrokeLineJoin="Round"
                                          Data="M 3.5,7 L 10,3.2 L 16.5,7 V 13.5 L 10,17.2 L 3.5,13.5 Z M 3.5,7 L 10,10.5 L 16.5,7 M 10,10.5 V 17.2"/>
                                </Canvas>
                            </Viewbox>
                        </RadioButton>
                    </StackPanel>
                </Border>

                <!-- 全体 / KF個別切替 -->
                <Border Style="{StaticResource PillBox}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource HdrSegmentBtn}" GroupName="KeyFrameScope"
                                     IsChecked="{Binding IsEditAll, Mode=OneWay}"
                                     Command="{Binding SetEditAllCommand}"
                                     ToolTip="全体編集 — アイテム全体の位置・拡大・角度に加算">
                            <Viewbox Width="16" Height="16" IsHitTestVisible="False">
                                <Canvas Width="20" Height="20">
                                    <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Data="M 3,6.5 V 13.5 M 17,6.5 V 13.5 M 3,10 H 17"/>
                                </Canvas>
                            </Viewbox>
                        </RadioButton>
                        <RadioButton Style="{StaticResource HdrSegmentBtn}" GroupName="KeyFrameScope"
                                     IsChecked="{Binding IsEditKeyFrameOnly, Mode=OneWay}"
                                     Command="{Binding SetEditKeyFrameOnlyCommand}"
                                     ToolTip="KF個別編集 — 現在フレームに最も近いキーフレーム値のみを編集">
                            <Viewbox Width="16" Height="16" IsHitTestVisible="False">
                                <Canvas Width="20" Height="20">
                                    <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.6" StrokeLineJoin="Round"
                                          Fill="#35FFFFFF"
                                          Data="M 10,3.5 L 16.5,10 L 10,16.5 L 3.5,10 Z"/>
                                </Canvas>
                            </Viewbox>
                        </RadioButton>
                    </StackPanel>
                </Border>

                <!-- 透視投影 / 平行投影切替 -->
                <Border Style="{StaticResource PillBox}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource HdrSegmentBtn}" GroupName="ProjectionMode"
                                     IsChecked="{Binding IsPerspective, Mode=OneWay}"
                                     Command="{Binding SetPerspectiveCommand}"
                                     ToolTip="透視投影 [Num5] — 遠近感のあるカメラ表示">
                            <Viewbox Width="16" Height="16" IsHitTestVisible="False">
                                <Canvas Width="20" Height="20">
                                    <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.25" StrokeLineJoin="Round"
                                          Data="M 2,3 H 5.5 V 6 H 2 Z M 5.5,4 L 7.8,2.7 V 6.3 L 5.5,5"/>
                                    <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.2" StrokeLineJoin="Round"
                                          Data="M 5,9.5 H 15 L 18.2,17 H 1.8 Z M 8.3,9.5 L 7.2,17 M 11.7,9.5 L 12.8,17 M 3.5,13 H 16.5"/>
                                </Canvas>
                            </Viewbox>
                        </RadioButton>
                        <RadioButton Style="{StaticResource HdrSegmentBtn}" GroupName="ProjectionMode"
                                     IsChecked="{Binding IsOrthographic, Mode=OneWay}"
                                     Command="{Binding SetOrthographicCommand}"
                                     ToolTip="平行投影 [Num5] — 歪みのない正面・側面・上面配置向け表示">
                            <Viewbox Width="16" Height="16" IsHitTestVisible="False">
                                <Canvas Width="20" Height="20">
                                    <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.25" StrokeLineJoin="Round"
                                          Data="M 1.5,3 H 4.8 V 6 H 1.5 Z M 4.8,4 L 6.8,2.8 V 6.2 L 4.8,5"/>
                                    <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.2" StrokeLineJoin="Round"
                                          Data="M 6,7 H 18 V 17 H 6 Z M 10,7 V 17 M 14,7 V 17 M 6,10.3 H 18 M 6,13.7 H 18"/>
                                </Canvas>
                            </Viewbox>
                        </RadioButton>
                    </StackPanel>
                </Border>

                <!-- カメラ操作：注目 / YMMカメラ同期 / リセット -->
                <StackPanel Orientation="Horizontal" Margin="0,1,6,1">
                    <Button Style="{StaticResource HdrIconBtn}"
                            Command="{Binding FocusSelectedCommand}"
                            ToolTip="注目 [F] — 選択中アイテムをカメラ中心にフォーカス">
                        <Viewbox Width="16" Height="16" IsHitTestVisible="False">
                            <Canvas Width="20" Height="20">
                                <Ellipse Canvas.Left="3" Canvas.Top="3" Width="14" Height="14"
                                         Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5"/>
                                <Ellipse Canvas.Left="7.5" Canvas.Top="7.5" Width="5" Height="5"
                                         Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Button Style="{StaticResource HdrIconBtn}"
                            Command="{Binding ViewYmmCameraCommand}"
                            ToolTip="YMMカメラ同期 [Num0] — メインプレビューと同じカメラ視点に合わせる">
                        <Viewbox Width="17" Height="16" IsHitTestVisible="False">
                            <Canvas Width="22" Height="18">
                                <Border Canvas.Left="1" Canvas.Top="3.5" Width="13" Height="11" CornerRadius="1.5"
                                        BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" BorderThickness="1.35">
                                    <TextBlock Text="ゆ" FontSize="7.8" FontWeight="Bold"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                                </Border>
                                <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.35" StrokeLineJoin="Round"
                                      Data="M 14,7 L 19.8,4 V 14 L 14,11"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Button Style="{StaticResource HdrIconBtn}"
                            Command="{Binding ResetCameraCommand}"
                            ToolTip="カメラリセット — 視点を初期角度・位置に戻す">
                        <Viewbox Width="16" Height="16" IsHitTestVisible="False">
                            <Canvas Width="20" Height="20">
                                <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.25" StrokeLineJoin="Round"
                                      Data="M 2.5,2.5 H 8 V 6.5 H 2.5 Z M 8,3.6 L 11.2,2.2 V 6.8 L 8,5.4"/>
                                <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Data="M 7.25,9.75 A 4.6,4.6 0 1 0 13.75,9.75 M 13.75,12.6 L 13.75,9.75 L 16.6,9.75"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                </StackPanel>

                <!-- オーバーレイ表示切替：グリッド / カメラ枠 / 光源 -->
                <StackPanel Orientation="Horizontal" Margin="0,1,2,1">
                    <ToggleButton Style="{StaticResource HdrIconToggle}"
                                  IsChecked="{Binding ShowGrid}"
                                  ToolTip="グリッド表示 — 床面の基準グリッド線を表示/非表示">
                        <Viewbox Width="16" Height="16" IsHitTestVisible="False">
                            <Canvas Width="20" Height="20">
                                <Rectangle Canvas.Left="3" Canvas.Top="3" Width="14" Height="14"
                                           Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                           StrokeThickness="1.25" StrokeDashArray="2.2,1.6"/>
                                <Line X1="7.7" Y1="3" X2="7.7" Y2="17" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.1" StrokeDashArray="2.2,1.6"/>
                                <Line X1="12.3" Y1="3" X2="12.3" Y2="17" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.1" StrokeDashArray="2.2,1.6"/>
                                <Line X1="3" Y1="7.7" X2="17" Y2="7.7" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.1" StrokeDashArray="2.2,1.6"/>
                                <Line X1="3" Y1="12.3" X2="17" Y2="12.3" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.1" StrokeDashArray="2.2,1.6"/>
                            </Canvas>
                        </Viewbox>
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource HdrIconToggle}"
                                  IsChecked="{Binding ShowCameraFrustum}"
                                  ToolTip="カメラ枠表示 — YMM4カメラの画角錐台ガイドを表示/非表示">
                        <Viewbox Width="16" Height="16" IsHitTestVisible="False">
                            <Canvas Width="20" Height="20">
                                <Rectangle Canvas.Left="2" Canvas.Top="6.5" Width="7.5" Height="7" RadiusX="1.3" RadiusY="1.3"
                                           Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.35"/>
                                <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.3"
                                      StrokeDashArray="2.2,1.5" StrokeLineJoin="Round"
                                      Data="M 9.8,8.5 L 18,4 V 16 L 9.8,11.5"/>
                            </Canvas>
                        </Viewbox>
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource HdrIconToggle}"
                                  IsChecked="{Binding ShowLights}"
                                  ToolTip="光源表示 — 3D光源の位置と照射範囲ガイドを表示/非表示">
                        <Viewbox Width="16" Height="16" IsHitTestVisible="False">
                            <Canvas Width="20" Height="20">
                                <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.35" StrokeLineJoin="Round"
                                      Data="M 6.9,11.5 A 5.0,5.0 0 1 1 13.1,11.5 C 12.4,12.3 12.2,13.0 12.2,14.0 V 16.1 C 12.2,16.8 11.6,17.3 10.9,17.3 H 9.1 C 8.4,17.3 7.8,16.8 7.8,16.1 V 14.0 C 7.8,13.0 7.6,12.3 6.9,11.5 Z"/>
                                <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.15" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M 7.9,14.3 H 12.1 M 8.3,8.4 H 11.7 M 9.2,8.4 L 8.7,11.5 M 10.8,8.4 L 11.3,11.5"/>
                            </Canvas>
                        </Viewbox>
                    </ToggleButton>
                </StackPanel>

                <!-- 非破壊モディファイア / マテリアルパネル切替 (オブジェクトモード/モデル編集両対応) -->
                <Border Style="{StaticResource PillBox}" Margin="4,1,2,1"
                        Visibility="{Binding IsLayoutWorkspace, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <ToggleButton Style="{StaticResource HdrIconToggle}" Width="Auto" Padding="7,0" Margin="0"
                                      IsChecked="{Binding IsModifierPanelOpen}"
                                      ToolTip="非破壊モディファイア (ミラー・ソリッド化・ブーリアン・配列・三角形化・ベベル・シュリンクラップ・細分化・ディスプレイス)">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Viewbox Width="13" Height="13" Margin="0,0,4,0" IsHitTestVisible="False">
                                    <Canvas Width="20" Height="20">
                                        <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                              Data="M 14.7,4.2 A 4.8,4.8 0 0 0 8.8,9.9 L 3.2,15.5 A 1.3,1.3 0 0 0 5.0,17.3 L 10.6,11.7 A 4.8,4.8 0 0 0 16.3,5.8 L 13.7,8.4 L 12.1,6.8 L 14.7,4.2 Z"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="{Binding ModifierButtonLabel}" FontSize="10.5"/>
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton Style="{StaticResource HdrIconToggle}" Width="Auto" Padding="7,0" Margin="1,0,0,0"
                                      IsChecked="{Binding IsMaterialPanelOpen}"
                                      ToolTip="マテリアルスロット・PBR質感・背面非表示/影設定パネル (オブジェクトモード/編集両対応)">
                            <TextBlock Text="マテリアル" FontSize="10.5"/>
                        </ToggleButton>
                    </StackPanel>
                </Border>
            </WrapPanel>
        </Border>

        <!-- 中央：3Dビューポート ＋（シェーディング時は下部にノードエディタ） -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="120"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition x:Name="ShadingRow" Height="0"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 左縦ツールレール (レイアウト時のみ) -->
                <Border Grid.Column="0" Width="40" Background="#1F2228" BorderBrush="#343842" BorderThickness="0,0,1,0" Padding="3,6"
                        ButtonBase.Click="OnToolbarActionClicked"
                        Visibility="{Binding IsLayoutWorkspace, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                    <RadioButton Style="{StaticResource RailModeBtn}" GroupName="LeftToolMode"
                                 IsChecked="{Binding IsTranslateMode, Mode=OneWay}"
                                 Command="{Binding ModeTranslateCommand}"
                                 ToolTip="移動モード [W] — X/Y/Z軸・平面・画面平行移動">
                        <Viewbox Width="18" Height="18" IsHitTestVisible="False">
                            <Canvas Width="20" Height="20">
                                <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M 10,2 L 7.4,5 H 12.6 Z M 10,18 L 7.4,15 H 12.6 Z M 2,10 L 5,7.4 V 12.6 Z M 18,10 L 15,7.4 V 12.6 Z M 10,5 V 15 M 5,10 H 15"/>
                            </Canvas>
                        </Viewbox>
                    </RadioButton>

                    <RadioButton Style="{StaticResource RailModeBtn}" GroupName="LeftToolMode"
                                 IsChecked="{Binding IsRotateMode, Mode=OneWay}"
                                 Command="{Binding ModeRotateCommand}"
                                 ToolTip="回転モード [E] — X/Y/Z軸回転リング">
                        <Viewbox Width="18" Height="18" IsHitTestVisible="False">
                            <Canvas Width="20" Height="20">
                                <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M 4.5,8.5 A 6,6 0 0 1 15.2,6.5 M 15.2,6.5 L 15.4,3.8 M 15.2,6.5 L 12.4,6.4 M 15.5,11.5 A 6,6 0 0 1 4.8,13.5 M 4.8,13.5 L 4.6,16.2 M 4.8,13.5 L 7.6,13.6"/>
                            </Canvas>
                        </Viewbox>
                    </RadioButton>

                    <RadioButton Style="{StaticResource RailModeBtn}" GroupName="LeftToolMode"
                                 IsChecked="{Binding IsScaleMode, Mode=OneWay}"
                                 Command="{Binding ModeScaleCommand}"
                                 ToolTip="拡大モード [R] — 軸スケール・均一拡大ギズモ">
                        <Viewbox Width="18" Height="18" IsHitTestVisible="False">
                            <Canvas Width="20" Height="20">
                                <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.25"
                                      StrokeDashArray="2.2,1.6" StrokeLineJoin="Round"
                                      Data="M 6,11.5 V 3.5 H 16.5 V 14 H 10.5"/>
                                <Rectangle Canvas.Left="2.5" Canvas.Top="11.5" Width="6.5" Height="6.5" RadiusX="1.2" RadiusY="1.2"
                                           Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.45"
                                           Fill="#20FFFFFF"/>
                            </Canvas>
                        </Viewbox>
                    </RadioButton>

                    <Border Height="1" Background="#343842" Margin="4,6"/>

                    <ToggleButton Style="{StaticResource RailToggleBtn}"
                                  IsChecked="{Binding IsModelEditMode}"
                                  ToolTip="モデル編集 [Tab] — 頂点・辺・面の編集 / 押出(E) / 面張(F) / ループカット(Ctrl+R)">
                        <Viewbox Width="18" Height="18" IsHitTestVisible="False">
                            <Canvas Width="20" Height="20">
                                <Rectangle Canvas.Left="4.5" Canvas.Top="4.5" Width="11" Height="11"
                                           Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.35"/>
                                <Ellipse Canvas.Left="2.7" Canvas.Top="2.7" Width="3.6" Height="3.6" Fill="#1F2228"
                                         Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.2"/>
                                <Ellipse Canvas.Left="2.7" Canvas.Top="13.7" Width="3.6" Height="3.6" Fill="#1F2228"
                                         Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.2"/>
                                <Ellipse Canvas.Left="13.7" Canvas.Top="13.7" Width="3.6" Height="3.6" Fill="#1F2228"
                                         Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.2"/>
                                <Ellipse Canvas.Left="13.2" Canvas.Top="2.2" Width="4.8" Height="4.8"
                                         Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                            </Canvas>
                        </Viewbox>
                    </ToggleButton>
                </StackPanel>
            </Border>

            <!-- D3D11 ホスト -->
            <Border Grid.Column="1" x:Name="ViewportContainer" Background="#16181D" ClipToBounds="True"/>

            <!-- モデル編集時：右マテリアルインスペクター (レイアウト編集時のみ) -->
            <Border Grid.Column="2" Width="232"
                    Background="#1D2027" BorderBrush="#343842" BorderThickness="1,0,0,0"
                    PreviewMouseUp="OnMaterialPanelPreviewMouseUp"
                    Visibility="{Binding IsLayoutMaterialPanelVisible, Converter={StaticResource BoolToVis}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel Margin="8,6,8,10">
                        <TextBlock Text="マテリアルスロット" Foreground="#E5E7EB" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,5"/>

                        <UniformGrid Columns="3" Margin="0,0,0,5">
                            <Button Style="{StaticResource MatSmallBtn}" Content="+ 新規"
                                    Command="{Binding AddMaterialSlotCommand}" Click="OnToolbarActionClicked"
                                    ToolTip="新しいマテリアルスロットを追加"/>
                            <Button Style="{StaticResource MatSmallBtn}" Content="複製"
                                    Command="{Binding DuplicateMaterialSlotCommand}" Click="OnToolbarActionClicked"
                                    ToolTip="選択中のマテリアルスロットを複製"/>
                            <Button Style="{StaticResource MatSmallBtn}" Content="削除"
                                    Command="{Binding RemoveMaterialSlotCommand}" Click="OnToolbarActionClicked"
                                    ToolTip="選択中のマテリアルスロットを削除 (残り1つ時は不可)"/>
                        </UniformGrid>

                        <ListBox ItemsSource="{Binding MaterialSlots}"
                                 SelectedIndex="{Binding ActiveMaterialIndex, Mode=TwoWay}"
                                 MaxHeight="116" Background="#16191F" BorderBrush="#343842" BorderThickness="1"
                                 Foreground="#E5E7EB" Focusable="False" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Focusable" Value="False"/>
                                    <Setter Property="Padding" Value="4,2.5"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="#E5E7EB"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#2A303B"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#2563EB"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="11" Height="11" CornerRadius="2" Margin="0,0,6,0"
                                                Background="{Binding ColorSwatch}" BorderBrush="#64748B" BorderThickness="0.8"/>
                                        <TextBlock Text="{Binding DisplayText}" FontSize="10.5" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <UniformGrid Columns="2" Margin="0,5,0,2">
                            <Button Style="{StaticResource MatSmallBtn}" Content="面へ割当"
                                    Command="{Binding AssignMaterialCommand}" Click="OnToolbarActionClicked"
                                    ToolTip="選択中の面にこのマテリアルを割り当て"/>
                            <Button Style="{StaticResource MatSmallBtn}" Content="同材質を選択"
                                    Command="{Binding SelectByMaterialCommand}" Click="OnToolbarActionClicked"
                                    ToolTip="このマテリアルが割り当てられた面をすべて選択"/>
                        </UniformGrid>

                        <TextBlock Style="{StaticResource MatSectionHdr}" Text="名前"/>
                        <TextBox Text="{Binding ActiveMaterialName, UpdateSourceTrigger=PropertyChanged}"
                                 Background="#16191F" Foreground="#E5E7EB" CaretBrush="#E5E7EB"
                                 BorderBrush="#3D434F" BorderThickness="1" Padding="5,3" FontSize="11"
                                 Focusable="True" InputMethod.IsInputMethodEnabled="True"
                                 PreviewKeyDown="OnMaterialTextBoxPreviewKeyDown"/>

                        <Grid Margin="0,8,0,3">
                            <TextBlock Text="ベースカラー" Foreground="#9CA5B4" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Border Width="14" Height="12" CornerRadius="2" BorderBrush="#64748B" BorderThickness="1"
                                        Background="{Binding ActiveMatBaseBrush}" Margin="0,0,5,0"/>
                                <TextBlock Text="{Binding ActiveMatBaseColorHex}" Foreground="#CBD5E1" FontSize="10" FontFamily="Consolas"/>
                            </StackPanel>
                        </Grid>

                        <WrapPanel Margin="0,0,0,4">
                            <Button Style="{StaticResource MatSwatchBtn}" Background="#FFFFFF" Command="{Binding ApplyBaseColorSwatchCommand}" CommandParameter="#FFFFFF" Click="OnToolbarActionClicked"/>
                            <Button Style="{StaticResource MatSwatchBtn}" Background="#9CA3AF" Command="{Binding ApplyBaseColorSwatchCommand}" CommandParameter="#9CA3AF" Click="OnToolbarActionClicked"/>
                            <Button Style="{StaticResource MatSwatchBtn}" Background="#E05252" Command="{Binding ApplyBaseColorSwatchCommand}" CommandParameter="#E05252" Click="OnToolbarActionClicked"/>
                            <Button Style="{StaticResource MatSwatchBtn}" Background="#E59838" Command="{Binding ApplyBaseColorSwatchCommand}" CommandParameter="#E59838" Click="OnToolbarActionClicked"/>
                            <Button Style="{StaticResource MatSwatchBtn}" Background="#E6C845" Command="{Binding ApplyBaseColorSwatchCommand}" CommandParameter="#E6C845" Click="OnToolbarActionClicked"/>
                            <Button Style="{StaticResource MatSwatchBtn}" Background="#4CAF50" Command="{Binding ApplyBaseColorSwatchCommand}" CommandParameter="#4CAF50" Click="OnToolbarActionClicked"/>
                            <Button Style="{StaticResource MatSwatchBtn}" Background="#3B82F6" Command="{Binding ApplyBaseColorSwatchCommand}" CommandParameter="#3B82F6" Click="OnToolbarActionClicked"/>
                            <Button Style="{StaticResource MatSwatchBtn}" Background="#A855F7" Command="{Binding ApplyBaseColorSwatchCommand}" CommandParameter="#A855F7" Click="OnToolbarActionClicked"/>
                        </WrapPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="22"/>
                                <RowDefinition Height="22"/>
                                <RowDefinition Height="22"/>
                                <RowDefinition Height="22"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource MatLabel}" Text="R"/>
                            <ctrl:NumericTextBoxSlider Grid.Row="0" Grid.Column="1" IsDarkTheme="True" IsInteger="True" Minimum="0" Maximum="255" SmallChange="1" LargeChange="10" TickFrequency="1" IsSnapToTickEnabled="True" StringFormat="0" TextBoxWidth="40" Value="{Binding ActiveMatR, Mode=TwoWay}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource MatLabel}" Text="G"/>
                            <ctrl:NumericTextBoxSlider Grid.Row="1" Grid.Column="1" IsDarkTheme="True" IsInteger="True" Minimum="0" Maximum="255" SmallChange="1" LargeChange="10" TickFrequency="1" IsSnapToTickEnabled="True" StringFormat="0" TextBoxWidth="40" Value="{Binding ActiveMatG, Mode=TwoWay}"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource MatLabel}" Text="B"/>
                            <ctrl:NumericTextBoxSlider Grid.Row="2" Grid.Column="1" IsDarkTheme="True" IsInteger="True" Minimum="0" Maximum="255" SmallChange="1" LargeChange="10" TickFrequency="1" IsSnapToTickEnabled="True" StringFormat="0" TextBoxWidth="40" Value="{Binding ActiveMatB, Mode=TwoWay}"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource MatLabel}" Text="A"/>
                            <ctrl:NumericTextBoxSlider Grid.Row="3" Grid.Column="1" IsDarkTheme="True" IsInteger="True" Minimum="0" Maximum="255" SmallChange="1" LargeChange="10" TickFrequency="1" IsSnapToTickEnabled="True" StringFormat="0" TextBoxWidth="40" Value="{Binding ActiveMatA, Mode=TwoWay}"/>
                        </Grid>

                        <TextBlock Style="{StaticResource MatSectionHdr}" Text="質感プリセット"/>
                        <UniformGrid Columns="3">
                            <Button Style="{StaticResource MatSmallBtn}" Margin="1" Content="マット" Command="{Binding ApplyMaterialPresetCommand}" CommandParameter="Matte" Click="OnToolbarActionClicked"/>
                            <Button Style="{StaticResource MatSmallBtn}" Margin="1" Content="プラ" Command="{Binding ApplyMaterialPresetCommand}" CommandParameter="Plastic" Click="OnToolbarActionClicked"/>
                            <Button Style="{StaticResource MatSmallBtn}" Margin="1" Content="クロム" Command="{Binding ApplyMaterialPresetCommand}" CommandParameter="Chrome" Click="OnToolbarActionClicked"/>
                            <Button Style="{StaticResource MatSmallBtn}" Margin="1" Content="金" Command="{Binding ApplyMaterialPresetCommand}" CommandParameter="Gold" Click="OnToolbarActionClicked"/>
                            <Button Style="{StaticResource MatSmallBtn}" Margin="1" Content="ガラス" Command="{Binding ApplyMaterialPresetCommand}" CommandParameter="Glass" Click="OnToolbarActionClicked"/>
                            <Button Style="{StaticResource MatSmallBtn}" Margin="1" Content="発光" Command="{Binding ApplyMaterialPresetCommand}" CommandParameter="Emissive" Click="OnToolbarActionClicked"/>
                        </UniformGrid>
                        <Button Style="{StaticResource MatSmallBtn}" Margin="1,2,1,0" Height="22"
                                Content="輪郭(背面) プリセット"
                                Command="{Binding ApplyMaterialPresetCommand}" CommandParameter="OutlineBackface" Click="OnToolbarActionClicked"
                                ToolTip="黒単色・裏面非表示(Cull Backface)・影なしを設定 (ソリッド化背面法アウトライン用)"/>

                        <TextBlock Style="{StaticResource MatSectionHdr}" Text="PBR パラメータ"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="52"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="22"/>
                                <RowDefinition Height="22"/>
                                <RowDefinition Height="22"/>
                                <RowDefinition Height="22"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource MatLabel}" Text="金属感"/>
                            <ctrl:NumericTextBoxSlider Grid.Row="0" Grid.Column="1" IsDarkTheme="True" Minimum="0" Maximum="1" SmallChange="0.01" LargeChange="0.1" StringFormat="0.00" TextBoxWidth="44" Value="{Binding ActiveMatMetallic, Mode=TwoWay}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource MatLabel}" Text="粗さ"/>
                            <ctrl:NumericTextBoxSlider Grid.Row="1" Grid.Column="1" IsDarkTheme="True" Minimum="0.04" Maximum="1" SmallChange="0.01" LargeChange="0.1" StringFormat="0.00" TextBoxWidth="44" Value="{Binding ActiveMatRoughness, Mode=TwoWay}"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource MatLabel}" Text="ガラス透過"/>
                            <ctrl:NumericTextBoxSlider Grid.Row="2" Grid.Column="1" IsDarkTheme="True" Minimum="0" Maximum="1" SmallChange="0.01" LargeChange="0.1" StringFormat="0.00" TextBoxWidth="44" Value="{Binding ActiveMatTransmission, Mode=TwoWay}"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource MatLabel}" Text="屈折率"/>
                            <ctrl:NumericTextBoxSlider Grid.Row="3" Grid.Column="1" IsDarkTheme="True" Minimum="1.0" Maximum="2.5" SmallChange="0.01" LargeChange="0.1" StringFormat="0.00" TextBoxWidth="44" Value="{Binding ActiveMatIor, Mode=TwoWay}"/>
                        </Grid>

                        <Grid Margin="0,8,0,3">
                            <TextBlock Text="発光 (Emissive)" Foreground="#9CA5B4" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Border Width="14" Height="12" CornerRadius="2" BorderBrush="#64748B" BorderThickness="1"
                                    HorizontalAlignment="Right" Background="{Binding ActiveMatEmissiveBrush}"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="22"/>
                                <RowDefinition Height="22"/>
                                <RowDefinition Height="22"/>
                                <RowDefinition Height="22"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource MatLabel}" Text="発R"/>
                            <ctrl:NumericTextBoxSlider Grid.Row="0" Grid.Column="1" IsDarkTheme="True" IsInteger="True" Minimum="0" Maximum="255" SmallChange="1" LargeChange="10" TickFrequency="1" IsSnapToTickEnabled="True" StringFormat="0" TextBoxWidth="40" Value="{Binding ActiveMatEmR, Mode=TwoWay}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource MatLabel}" Text="発G"/>
                            <ctrl:NumericTextBoxSlider Grid.Row="1" Grid.Column="1" IsDarkTheme="True" IsInteger="True" Minimum="0" Maximum="255" SmallChange="1" LargeChange="10" TickFrequency="1" IsSnapToTickEnabled="True" StringFormat="0" TextBoxWidth="40" Value="{Binding ActiveMatEmG, Mode=TwoWay}"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource MatLabel}" Text="発B"/>
                            <ctrl:NumericTextBoxSlider Grid.Row="2" Grid.Column="1" IsDarkTheme="True" IsInteger="True" Minimum="0" Maximum="255" SmallChange="1" LargeChange="10" TickFrequency="1" IsSnapToTickEnabled="True" StringFormat="0" TextBoxWidth="40" Value="{Binding ActiveMatEmB, Mode=TwoWay}"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource MatLabel}" Text="強さ"/>
                            <ctrl:NumericTextBoxSlider Grid.Row="3" Grid.Column="1" IsDarkTheme="True" Minimum="0" Maximum="10" SmallChange="0.1" LargeChange="1" StringFormat="0.00" TextBoxWidth="44" Value="{Binding ActiveMatEmStrength, Mode=TwoWay}"/>
                        </Grid>

                        <TextBlock Style="{StaticResource MatSectionHdr}" Text="描画オプション"/>
                        <CheckBox Style="{StaticResource MatDarkCheckBox}" Margin="0,2,0,4"
                                  Content="裏面を非表示 (Cull Backface)"
                                  IsChecked="{Binding ActiveMatCullBackface, Mode=TwoWay}"
                                  ToolTip="チェックするとカメラから見て裏面のポリゴンを描画しません (背面法輪郭用)"/>
                        <CheckBox Style="{StaticResource MatDarkCheckBox}" Margin="0,0,0,2"
                                  Content="影を落とす (Cast Shadow)"
                                  IsChecked="{Binding ActiveMatCastShadow, Mode=TwoWay}"
                                  ToolTip="OFF にするとこのマテリアルが他オブジェクトへ影を落とさなくなります"/>

                        <Button Style="{StaticResource MatSmallBtn}" Margin="0,8,0,0" Height="23"
                                Content="元テクスチャを解除 (単色編集へ)"
                                Command="{Binding ClearMaterialTextureCommand}" Click="OnToolbarActionClicked"
                                Visibility="{Binding ActiveMatHasOriginalTexture, Converter={StaticResource BoolToVis}}"
                                ToolTip="モデル読込時のテクスチャ参照を切り離し、ベースカラー単色での表示に切り替えます"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- オブジェクト / モデル編集共通：右モディファイアスタックパネル -->
            <modifiers:ModifierPanelControl Grid.Column="2" x:Name="ModifierPanelControl" Width="268"
                                              Visibility="{Binding IsLayoutModifierPanelVisible, Converter={StaticResource BoolToVis}}"
                                              PreviewMouseUp="OnMaterialPanelPreviewMouseUp"/>
            </Grid>

            <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                          Background="#2B303A" Cursor="SizeNS" Focusable="False"
                          Visibility="{Binding IsShadingWorkspace, Converter={StaticResource BoolToVis}}"/>

            <shading:ShaderNodeEditorControl Grid.Row="2" x:Name="NodeEditorControl"
                                             Visibility="{Binding IsShadingWorkspace, Converter={StaticResource BoolToVis}}"/>
        </Grid>

        <!-- 下部ステータスバー -->
        <Border Grid.Row="3" Background="#1D4E89" Padding="8,3">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Right" Text="{Binding SceneSummaryText}"
                           Foreground="#DCE8F8" FontSize="11" Margin="12,0,0,0"
                           VerticalAlignment="Center"/>
                <TextBlock Text="{Binding StatusText}"
                           Foreground="White" FontSize="11"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
