<UserControl x:Class="Iyahon_D3D11Renderer_Core.Viewport3D.Shading.ShaderNodeEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:Iyahon_D3D11Renderer_Core.Controls"
             Background="#17191E"
             Focusable="True"
             PreviewKeyDown="OnEditorPreviewKeyDown">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="NodeToolBtn" TargetType="Button">
            <Setter Property="Height" Value="22"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Padding" Value="7,0"/>
            <Setter Property="Background" Value="#272B33"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="BorderBrush" Value="#3E4552"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#353B47"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#5C667A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2563EB"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkNodeCombo" TargetType="ComboBox">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="#E5E7EB"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="#252930" BorderBrush="#3E4552" BorderThickness="1" CornerRadius="3" Padding="4,1">
                                            <TextBlock Text="▾" Foreground="#9CA5B4" FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False" Margin="6,1,18,1"
                                              VerticalAlignment="Center" HorizontalAlignment="Left"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                            <Popup Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border MinWidth="{TemplateBinding ActualWidth}" MaxHeight="240"
                                        Background="#1F242C" BorderBrush="#485060" BorderThickness="1" CornerRadius="3" Padding="2">
                                    <ScrollViewer SnapsToDevicePixels="True" Focusable="False">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="Padding" Value="6,3"/>
                        <Setter Property="Foreground" Value="#E5E7EB"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="2" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#344960"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#2563EB"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkContextMenu" TargetType="ContextMenu">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="HasDropShadow" Value="True"/>
            <Setter Property="Background" Value="#1D2129"/>
            <Setter Property="BorderBrush" Value="#4A5568"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#F1F5F9"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="4"
                                MinWidth="172">
                            <ScrollViewer CanContentScroll="True"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel IsItemsHost="True"
                                            KeyboardNavigation.DirectionalNavigation="Cycle"/>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkMenuSeparator" TargetType="Separator">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Margin" Value="6,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="#363E4D"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkMenuItem" TargetType="MenuItem">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Foreground" Value="#F1F5F9"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MinWidth" Value="168"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0"
                                                  ContentSource="Icon"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Center"
                                                  SnapsToDevicePixels="True"/>
                                <ContentPresenter Grid.Column="1"
                                                  ContentSource="Header"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True"/>
                                <TextBlock Grid.Column="2"
                                           Text="{TemplateBinding InputGestureText}"
                                           Foreground="#94A3B8"
                                           FontSize="10.5"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2563EB"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#64748B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Role" Value="SubmenuHeader">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="MenuItem">
                                <Grid>
                                    <Border x:Name="Bd"
                                            Background="Transparent"
                                            CornerRadius="3"
                                            Padding="{TemplateBinding Padding}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="18"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ContentPresenter Grid.Column="0"
                                                              ContentSource="Icon"
                                                              HorizontalAlignment="Left"
                                                              VerticalAlignment="Center"/>
                                            <ContentPresenter Grid.Column="1"
                                                              ContentSource="Header"
                                                              VerticalAlignment="Center"
                                                              RecognizesAccessKey="True"/>
                                            <TextBlock x:Name="Arrow"
                                                       Grid.Column="2"
                                                       Text="▸"
                                                       Foreground="#94A3B8"
                                                       FontSize="10.5"
                                                       Margin="12,0,2,0"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <Popup x:Name="PART_Popup"
                                           Placement="Right"
                                           HorizontalOffset="-2"
                                           VerticalOffset="-4"
                                           AllowsTransparency="True"
                                           Focusable="False"
                                           PopupAnimation="Fade"
                                           IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
                                        <Border Background="#1D2129"
                                                BorderBrush="#4A5568"
                                                BorderThickness="1"
                                                CornerRadius="5"
                                                Padding="4"
                                                MinWidth="178">
                                            <ScrollViewer CanContentScroll="True"
                                                          VerticalScrollBarVisibility="Auto"
                                                          HorizontalScrollBarVisibility="Disabled">
                                                <StackPanel IsItemsHost="True"
                                                            KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                            </ScrollViewer>
                                        </Border>
                                    </Popup>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#2B4C7E"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                        <Setter TargetName="Arrow" Property="Foreground" Value="#FFFFFF"/>
                                    </Trigger>
                                    <Trigger Property="IsSubmenuOpen" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#2B4C7E"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                        <Setter TargetName="Arrow" Property="Foreground" Value="#FFFFFF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ドットグリッド背景ブラシ -->
        <DrawingBrush x:Key="NodeGridBrush" TileMode="Tile" Viewport="0,0,28,28" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#181A1F">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,28,28"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#2B303A">
                        <GeometryDrawing.Geometry>
                            <EllipseGeometry Center="14,14" RadiusX="1.1" RadiusY="1.1"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 上部：シェーディングサブツールバー -->
        <Border Grid.Row="0" Background="#20232A" BorderBrush="#343842" BorderThickness="0,1,0,1" Padding="6,4">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#181B21" BorderBrush="#343A46" BorderThickness="1" CornerRadius="3" Padding="7,2" Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="対象:" Foreground="#8892A2" FontSize="10.5" Margin="0,0,4,0"/>
                        <TextBlock Text="{Binding ShadingTargetName}" Foreground="#93C5FD" FontSize="11" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="スロット:" Foreground="#9CA5B4" FontSize="11" VerticalAlignment="Center" Margin="2,0,4,0"/>
                <ComboBox Style="{StaticResource DarkNodeCombo}" Width="142" Margin="0,0,4,0"
                          ItemsSource="{Binding MaterialSlots}"
                          SelectedIndex="{Binding ActiveMaterialIndex, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="10" Height="10" CornerRadius="2" Margin="0,0,6,0"
                                        Background="{Binding ColorSwatch}" BorderBrush="#64748B" BorderThickness="0.8"/>
                                <TextBlock Text="{Binding DisplayText}" TextTrimming="CharacterEllipsis" MaxWidth="106"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <Button Style="{StaticResource NodeToolBtn}" Content="+ 新規" Command="{Binding AddMaterialSlotCommand}"/>
                <Button Style="{StaticResource NodeToolBtn}" Content="複製" Command="{Binding DuplicateMaterialSlotCommand}"/>
                <Button Style="{StaticResource NodeToolBtn}" Content="削除" Command="{Binding RemoveMaterialSlotCommand}"/>

                <Border Width="1" Background="#363C48" Margin="6,2"/>

                <Button x:Name="BtnAddShaderNode" Style="{StaticResource NodeToolBtn}" Content="+ ノード追加 ▾"
                        Click="OnAddNodeMenuClick"
                        ToolTip="シェーダーノードを追加 [Shift+A / 右クリック]"/>
                <Button x:Name="BtnNodePresets" Style="{StaticResource NodeToolBtn}" Content="プリセット ▾"
                        Click="OnPresetMenuClick"
                        ToolTip="ノイズ+バンプ・大理石・レンガ・画像ノーマルなどの典型ノード構成を適用"/>
                <Button Style="{StaticResource NodeToolBtn}" Content="ノード削除" Click="OnDeleteSelectedNodeClick"
                        ToolTip="選択中のノードを削除 [Delete / X]"/>
                <Button Style="{StaticResource NodeToolBtn}" Content="コピー" Click="OnCopySelectedNodesClick"
                        ToolTip="選択ノードをコピー [Ctrl+C]（別マテリアルへ貼付可）"/>
                <Button Style="{StaticResource NodeToolBtn}" Content="貼付" Click="OnPasteNodesClick"
                        ToolTip="コピーしたノードを貼り付け [Ctrl+V]"/>
                <Button x:Name="BtnShadeMenu" Style="{StaticResource NodeToolBtn}" Content="シェード ▾" Click="OnShadeMenuClick"
                        ToolTip="モデルのスムーズ / 自動スムーズ / フラットシェード切替"/>

                <Border Width="1" Background="#363C48" Margin="6,2"/>

                <TextBlock Text="ベイク解像度:" Foreground="#9CA5B4" FontSize="10.5" VerticalAlignment="Center" Margin="2,0,4,0"/>
                <ComboBox x:Name="CmbBakeResolution" Style="{StaticResource DarkNodeCombo}" Width="66"
                          SelectionChanged="OnBakeResolutionChanged"
                          ToolTip="プロシージャルノードテクスチャのGPUベイク解像度">
                    <ComboBoxItem Content="256" Tag="256"/>
                    <ComboBoxItem Content="512" Tag="512" IsSelected="True"/>
                    <ComboBoxItem Content="1024" Tag="1024"/>
                </ComboBox>

                <Button Style="{StaticResource NodeToolBtn}" Margin="6,0,0,0" Content="全体表示" Click="OnFrameAllNodesClick"
                        ToolTip="ノード配置に合わせて視点とズームをリセット"/>
            </WrapPanel>
        </Border>

        <!-- 中央：パン/ズーム可能なノードグラフキャンバス -->
        <Grid x:Name="GraphSurface" Grid.Row="1"
              Background="{StaticResource NodeGridBrush}"
              ClipToBounds="True"
              MouseDown="OnSurfaceMouseDown"
              MouseMove="OnSurfaceMouseMove"
              MouseUp="OnSurfaceMouseUp"
              LostMouseCapture="OnSurfaceLostMouseCapture"
              MouseWheel="OnSurfaceMouseWheel">

            <Canvas x:Name="WorldCanvas" RenderTransformOrigin="0,0">
                <Canvas.RenderTransform>
                    <MatrixTransform x:Name="PanZoomTransform"/>
                </Canvas.RenderTransform>
                <Canvas x:Name="LinksCanvas" IsHitTestVisible="False"/>
                <Canvas x:Name="NodesCanvas"/>
            </Canvas>

            <Canvas x:Name="SelectionOverlayCanvas" IsHitTestVisible="False">
                <Rectangle x:Name="SelectionBoxRect"
                           Fill="#2E3B82F6"
                           Stroke="#60A5FA"
                           StrokeThickness="1.2"
                           StrokeDashArray="4 2"
                           Visibility="Collapsed"/>
            </Canvas>

            <!-- 編集対象モデル未選択時の案内 -->
            <Border Background="#CC15181E" Visibility="{Binding IsShadingTargetMissing, Converter={StaticResource BoolToVis}}"
                    IsHitTestVisible="True">
                <Border Background="#232730" BorderBrush="#404756" BorderThickness="1" CornerRadius="6"
                        Padding="22,16" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="マテリアルノード編集の対象がありません"
                                   Foreground="#F1F5F9" FontSize="13.5" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="タイムライン上で「D3D11 3Dモデル」または「D3D11 図形」を選択してください。"
                                   Foreground="#9CA5B4" FontSize="11.5" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Border>

            <!-- 左下ヘルプ -->
            <Border Background="#9914171C" CornerRadius="3" Padding="7,3" Margin="8"
                    HorizontalAlignment="Left" VerticalAlignment="Bottom" IsHitTestVisible="False">
                <TextBlock Text="右クリック / Shift+A: ノード追加 | 左ドラッグ(背景): 範囲選択 | 左ドラッグ(ヘッダー): 移動 | 左ドラッグ(ピン): 接続・外す | Ctrl+C/V: コピペ | Shift+D: 複製 | Ctrl+A: 全選択 | Del/X: 削除"
                           Foreground="#8B95A6" FontSize="10"/>
            </Border>
        </Grid>

        <!-- カラーピッカー用コンパクトポップアップ -->
        <Popup x:Name="ColorPickerPopup" StaysOpen="False" Placement="MousePoint" AllowsTransparency="True" Closed="OnColorPickerPopupClosed">
            <Border Background="#1F242D" BorderBrush="#4E586B" BorderThickness="1" CornerRadius="5" Padding="10" Width="236">
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <TextBlock Text="カラー設定" Foreground="#E2E8F0" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Border x:Name="PickerPreviewSwatch" Width="18" Height="14" CornerRadius="2" BorderBrush="#64748B" BorderThickness="1" Margin="0,0,6,0"/>
                            <TextBlock x:Name="PickerHexLabel" Text="#FFFFFF" Foreground="#CBD5E1" FontSize="10.5" FontFamily="Consolas" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                    <WrapPanel x:Name="PickerSwatchesPanel" Margin="0,0,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="22"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="R" Foreground="#CBD5E1" FontSize="10.5" VerticalAlignment="Center"/>
                        <ctrl:NumericTextBoxSlider x:Name="PickerR" Grid.Row="0" Grid.Column="1" IsDarkTheme="True" IsInteger="True" Minimum="0" Maximum="255" SmallChange="1" LargeChange="10" TickFrequency="1" IsSnapToTickEnabled="True" StringFormat="0" TextBoxWidth="38" ValueChanged="OnPickerSliderChanged" ValueCommitted="OnPickerSliderCommitted"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="G" Foreground="#CBD5E1" FontSize="10.5" VerticalAlignment="Center"/>
                        <ctrl:NumericTextBoxSlider x:Name="PickerG" Grid.Row="1" Grid.Column="1" IsDarkTheme="True" IsInteger="True" Minimum="0" Maximum="255" SmallChange="1" LargeChange="10" TickFrequency="1" IsSnapToTickEnabled="True" StringFormat="0" TextBoxWidth="38" ValueChanged="OnPickerSliderChanged" ValueCommitted="OnPickerSliderCommitted"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="B" Foreground="#CBD5E1" FontSize="10.5" VerticalAlignment="Center"/>
                        <ctrl:NumericTextBoxSlider x:Name="PickerB" Grid.Row="2" Grid.Column="1" IsDarkTheme="True" IsInteger="True" Minimum="0" Maximum="255" SmallChange="1" LargeChange="10" TickFrequency="1" IsSnapToTickEnabled="True" StringFormat="0" TextBoxWidth="38" ValueChanged="OnPickerSliderChanged" ValueCommitted="OnPickerSliderCommitted"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="A" Foreground="#CBD5E1" FontSize="10.5" VerticalAlignment="Center"/>
                        <ctrl:NumericTextBoxSlider x:Name="PickerA" Grid.Row="3" Grid.Column="1" IsDarkTheme="True" IsInteger="True" Minimum="0" Maximum="255" SmallChange="1" LargeChange="10" TickFrequency="1" IsSnapToTickEnabled="True" StringFormat="0" TextBoxWidth="38" ValueChanged="OnPickerSliderChanged" ValueCommitted="OnPickerSliderCommitted"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
