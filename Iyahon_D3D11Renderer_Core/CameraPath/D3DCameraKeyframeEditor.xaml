<UserControl x:Class="Iyahon_D3D11Renderer_Core.CameraPath.D3DCameraKeyframeEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:YukkuriMovieMaker.Controls;assembly=YukkuriMovieMaker.Plugin"
             Name="this">
  <UserControl.Resources>
    <Style x:Key="D3DCamResizeHandle" TargetType="{x:Type Thumb}">
      <Setter Property="Height" Value="6"/>
      <Setter Property="Cursor" Value="SizeNS"/>
      <Setter Property="ToolTip" Value="ドラッグでリストの高さを変えられます"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Thumb}">
            <Border x:Name="bar" Background="#333842"/>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bar" Property="Background" Value="#5A6474"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <DataTemplate x:Key="PointRowTemplate">
      <StackPanel Margin="0,1">
        <TextBlock FontSize="11">
          <Run Text="F:"/><Run Text="{Binding Path=Frame.ActiveValues[0].Value, Mode=OneWay, StringFormat={}{0:F0}}"/>
          <Run Text=" 位置("/>
          <Run Text="{Binding Path=X.ActiveValues[0].Value, Mode=OneWay, StringFormat={}{0:F0}}"/><Run Text=","/>
          <Run Text="{Binding Path=Y.ActiveValues[0].Value, Mode=OneWay, StringFormat={}{0:F0}}"/><Run Text=","/>
          <Run Text="{Binding Path=Z.ActiveValues[0].Value, Mode=OneWay, StringFormat={}{0:F0}}"/><Run Text=")"/>
        </TextBlock>
        <TextBlock FontSize="11" Opacity="0.7">
          <Run Text="角度("/>
          <Run Text="{Binding Path=RotationX.ActiveValues[0].Value, Mode=OneWay, StringFormat={}{0:F1}}"/><Run Text=","/>
          <Run Text="{Binding Path=RotationY.ActiveValues[0].Value, Mode=OneWay, StringFormat={}{0:F1}}"/><Run Text=","/>
          <Run Text="{Binding Path=RotationZ.ActiveValues[0].Value, Mode=OneWay, StringFormat={}{0:F1}}"/><Run Text="°) 視野角 "/>
          <Run Text="{Binding Path=Fov.ActiveValues[0].Value, Mode=OneWay, StringFormat={}{0:F1}}"/><Run Text="°"/>
        </TextBlock>
      </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="SegmentRowTemplate">
      <StackPanel Orientation="Horizontal">
        <Path Width="52" Height="16" Stretch="None" StrokeThickness="1.4" VerticalAlignment="Center"
              Data="{Binding CurveGeometry}" Stroke="{Binding StrokeBrush}"/>
        <TextBlock Margin="8,0,0,0" FontSize="10" VerticalAlignment="Center" Opacity="0.85">
          <Run Text="区間 "/><Run Text="{Binding NumberText, Mode=OneWay}"/>
          <Run Text="   F"/><Run Text="{Binding From.Frame.ActiveValues[0].Value, Mode=OneWay, StringFormat={}{0:F0}}"/>
          <Run Text=" → F"/><Run Text="{Binding To.Frame.ActiveValues[0].Value, Mode=OneWay, StringFormat={}{0:F0}}"/>
        </TextBlock>
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition x:Name="listRow" Height="150" MinHeight="60" MaxHeight="420"/>
      <RowDefinition Height="6"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition/>
        <ColumnDefinition Width="30"/>
        <ColumnDefinition Width="30"/>
      </Grid.ColumnDefinitions>

      <ScrollViewer x:Name="listScroll" VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel x:Name="rowsPanel" Margin="0,1"/>
      </ScrollViewer>

      <Grid Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition/>
          <RowDefinition/>
          <RowDefinition/>
          <RowDefinition/>
        </Grid.RowDefinitions>
        <Button Grid.Row="0" x:Name="addButton" Content="＋" Click="AddButton_Click" ToolTip="設定点を追加します"/>
        <Button Grid.Row="1" x:Name="removeButton" Content="－" Click="RemoveButton_Click" ToolTip="選択中の設定点を削除します（Ctrl+クリックで複数選択）"/>
        <Button Grid.Row="2" x:Name="upButton" Content="▲" Click="UpButton_Click" ToolTip="選択中の設定点をひとつ上へ"/>
        <Button Grid.Row="3" x:Name="downButton" Content="▼" Click="DownButton_Click" ToolTip="選択中の設定点をひとつ下へ"/>
      </Grid>

      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition/>
          <RowDefinition/>
          <RowDefinition/>
        </Grid.RowDefinitions>
        <Button Grid.Row="0" x:Name="duplicateButton" Content="▣" Click="DuplicateButton_Click" ToolTip="選択中の設定点を複製して30フレーム後に置きます"/>
        <Button Grid.Row="1" x:Name="reverseButton" Content="⇅" Click="ReverseButton_Click" ToolTip="軌道全体を逆向き・逆順にします"/>
        <Button Grid.Row="2" x:Name="loopButton" Content="↺" Click="LoopButton_Click" ToolTip="終点から始点へ往復する設定点を追加します"/>
      </Grid>
    </Grid>

    <Thumb Grid.Row="1" x:Name="listResizeThumb" Style="{StaticResource D3DCamResizeHandle}"
           DragDelta="ListResizeThumb_DragDelta"/>

    <Border Grid.Row="2" x:Name="segmentPanel" Visibility="Collapsed" Margin="0,4,0,0"
            BorderBrush="#66FFC46B" BorderThickness="1,0,0,0" Padding="6,2,0,6">
      <StackPanel>
        <TextBlock x:Name="segmentHeader" FontSize="11" Opacity="0.85"/>
        <Grid x:Name="segmentHost" Margin="0,4,0,0"/>
      </StackPanel>
    </Border>

    <Grid Grid.Row="3" ClipToBounds="True">
      <ctrl:PropertiesEditor x:Name="pointEditor" Margin="0,-22,0,0"
                             BeginEdit="Editor_BeginEdit" EndEdit="Editor_EndEdit"
                             Targets="{Binding ElementName=this, Path=TargetKeyframes}"/>
    </Grid>

    <Border Grid.Row="4" Margin="0,6,0,2" Padding="6" CornerRadius="4"
            Background="#1B222E" BorderBrush="#334155" BorderThickness="1">
      <StackPanel>
        <TextBlock Text="D3D11 3Dビューポート操作" FontSize="11" FontWeight="SemiBold" Foreground="#93C5FD" Margin="0,0,0,4"/>
        <UniformGrid Columns="3">
          <Button x:Name="addCurrentViewButton" Content="現在視点を追加" Margin="0,0,3,0" Padding="4,4"
                  Click="AddCurrentViewButton_Click"
                  ToolTip="D3D11 3Dビューポートの現在の視点を新しい設定点として追加します"/>
          <Button x:Name="focusPathButton" Content="全体表示" Margin="1.5,0" Padding="4,4"
                  Click="FocusPathButton_Click"
                  ToolTip="パス全体が収まる位置へ D3D11 3Dビューポートの視点を合わせます"/>
          <Button x:Name="focusSelectedButton" Content="選択点へ注目" Margin="3,0,0,0" Padding="4,4"
                  Click="FocusSelectedButton_Click"
                  ToolTip="選択中の設定点へ D3D11 3Dビューポートの視点を移します"/>
        </UniformGrid>
        <TextBlock Text="※ 軌道・設定点・制御点・注視点は「D3D11 3Dビューポート」ウィンドウ上で他の3Dモデルを見ながら直接ドラッグ編集できます。"
                   FontSize="10" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,5,0,0"/>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
